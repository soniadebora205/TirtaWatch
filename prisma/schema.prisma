generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  extensions = [postgis]
}

model User {
  id String @id @default(uuid())
  full_name String
  email String @unique
  password_hash String
  role String @default("CITIZEN")
  created_at DateTime @default(now())
  status_changes StatusHistory[]
}

model Laporan {
  id String @id @default(uuid())
  ticket_code String @unique
  title String
  category_key String
  description String
  location String
  latitude Float
  longitude Float
  reporter_name String
  status String @default("baru")
  support_count Int @default(0)
  
  before_image_url String
  after_image_url String?   
  
  user_id String? @db.Uuid

  technician_name String?
  estimated_finish String?
  internal_note String?
  resolved_at DateTime?
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  status_histories StatusHistory[] 
}

model StatusHistory {
  id String @id @default(uuid())
  report_id String
  changed_by String
  status String
  note String?
  created_at DateTime @default(now())

  laporan Laporan @relation(fields: [report_id], references: [id])
  technician User @relation(fields: [changed_by], references: [id])
}

enum ROLE {
  CITIZEN
  ADMIN
  TECHNICIAN
}

enum Status {
  NEW
  IN_PROGRESS
  RESOLVED
}